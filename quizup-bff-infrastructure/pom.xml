<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.quizup</groupId>
        <artifactId>quizup-bff</artifactId>
        <version>4.14.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quizup-bff-infrastructure</artifactId>

    <properties>
        <!-- Contrats inter-services : dernières versions release des *-domain (GitHub Packages). -->
        <quizup.identity-domain.version>2.0.0</quizup.identity-domain.version>
        <quizup.theme-domain.version>4.5.2</quizup.theme-domain.version>
        <quizup.social-domain.version>4.0.0</quizup.social-domain.version>
        <quizup.game-domain.version>5.2.0</quizup.game-domain.version>
        <quizup.profile-domain.version>3.2.0</quizup.profile-domain.version>
        <quizup.matchmaking-domain.version>4.3.0</quizup.matchmaking-domain.version>
        <quizup.leaderboard-domain.version>3.0.0</quizup.leaderboard-domain.version>
        <!-- 2.3.0 requis : l'inbox doit désérialiser le type LOBBY_MISSED ; 2.5.0 : delete-all. -->
        <quizup.notification-domain.version>2.5.0</quizup.notification-domain.version>
        <!-- Web Push : JWT VAPID Nimbus + chiffrement BouncyCastle + HttpClient JDK. -->
        <webpush.version>6.1.3</webpush.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-microservice-starter</artifactId>
        </dependency>

        <!-- Contrats inter-services (queries / commands / read models / events) -->
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-identity-domain</artifactId>
            <version>${quizup.identity-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-theme-domain</artifactId>
            <version>${quizup.theme-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-social-domain</artifactId>
            <version>${quizup.social-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-game-domain</artifactId>
            <version>${quizup.game-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-profile-domain</artifactId>
            <version>${quizup.profile-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-matchmaking-domain</artifactId>
            <version>${quizup.matchmaking-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-leaderboard-domain</artifactId>
            <version>${quizup.leaderboard-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.quizup</groupId>
            <artifactId>quizup-notification-domain</artifactId>
            <version>${quizup.notification-domain.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Web Push (abonnements navigateur + envoi RFC 8030/8291). -->
        <dependency>
            <groupId>dev.blanke.webpush</groupId>
            <artifactId>webpush</artifactId>
            <version>${webpush.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.blanke.webpush.jwt</groupId>
            <artifactId>webpush-jwt-nimbus</artifactId>
            <version>${webpush.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.quizup.bff.BffServiceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
